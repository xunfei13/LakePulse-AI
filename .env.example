# 运行模式: local (本地轻量 Spark + DuckDB) | cluster (Docker HDFS + Hive Metastore + Spark)
LAKEPULSE_MODE=local

# 数据与产物路径
LAKEPULSE_DATA_DIR=./data
LAKEPULSE_DUCKDB_PATH=./data/lakehouse/lakepulse.duckdb
LAKEPULSE_MODELS_DIR=./artifacts/models

# 集群连接配置 (仅在 LAKEPULSE_MODE=cluster 时使用)
SPARK_MASTER_URL=spark://localhost:7077
HDFS_NAMENODE_URI=hdfs://localhost:9000
HIVE_METASTORE_URI=thrift://localhost:9083

# FastAPI 数据服务网关配置 (阶段 4)
API_HOST=127.0.0.1
API_PORT=8000
SQL_MAX_ROWS=500
SQL_TIMEOUT_SEC=10
