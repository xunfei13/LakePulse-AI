{
  "openapi": "3.1.0",
  "info": {
    "title": "LakePulse-AI Data & Replenishment Gateway",
    "description": "Read-only DuckDB lakehouse gateway guarded by a sqlglot AST firewall, providing pipeline health inspection, stockout alerts, SKU demand attribution, and controlled analytical SQL tools for Dify AI Agents.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Check API liveness and available whitelisted lakehouse tables",
        "operationId": "get_service_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ops/health-summary": {
      "get": {
        "summary": "Inspect latest ETL/ML audit statuses and TEST-split model accuracy",
        "operationId": "check_pipeline_and_model_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsHealthSummaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/replenishment/alerts": {
      "get": {
        "summary": "Query prioritized stockout alerts and replenishment orders",
        "operationId": "get_replenishment_alerts",
        "parameters": [
          {
            "name": "store_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Store ID e.g. CA_1",
              "title": "Store Id"
            },
            "description": "Store ID e.g. CA_1"
          },
          {
            "name": "abc_class",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ABC tier: A, B, or C",
              "title": "Abc Class"
            },
            "description": "ABC tier: A, B, or C"
          },
          {
            "name": "risk_level",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Risk tier: HIGH, MEDIUM, or LOW",
              "title": "Risk Level"
            },
            "description": "Risk tier: HIGH, MEDIUM, or LOW"
          },
          {
            "name": "cat_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Category ID e.g. FOODS, HOBBIES, HOUSEHOLD",
              "title": "Cat Id"
            },
            "description": "Category ID e.g. FOODS, HOBBIES, HOUSEHOLD"
          },
          {
            "name": "only_need_order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Filter to items with recommended_order_qty > 0",
              "default": true,
              "title": "Only Need Order"
            },
            "description": "Filter to items with recommended_order_qty > 0"
          },
          {
            "name": "max_budget",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional procurement budget cap ($) applied in priority order",
              "title": "Max Budget"
            },
            "description": "Optional procurement budget cap ($) applied in priority order"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "description": "Max rows returned",
              "default": 50,
              "title": "Limit"
            },
            "description": "Max rows returned"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplenishmentAlertsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/replenishment/sku-attribution/{store_id}/{item_id}": {
      "get": {
        "summary": "Explain demand drivers and safety-stock formula breakdown for a SKU",
        "operationId": "explain_sku_demand_drivers",
        "parameters": [
          {
            "name": "store_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Store Id"
            }
          },
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Item Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkuDemandAttributionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sql/query": {
      "post": {
        "summary": "Execute a read-only SELECT query validated by sqlglot AST firewall",
        "operationId": "execute_readonly_sql",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SQLQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SQLQueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditItem": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "pipeline_stage": {
            "type": "string",
            "title": "Pipeline Stage"
          },
          "table_name": {
            "type": "string",
            "title": "Table Name"
          },
          "finished_at": {
            "type": "string",
            "title": "Finished At"
          },
          "duration_sec": {
            "type": "number",
            "title": "Duration Sec"
          },
          "output_rows": {
            "type": "integer",
            "title": "Output Rows"
          },
          "null_rate": {
            "type": "number",
            "title": "Null Rate"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "pipeline_stage",
          "table_name",
          "finished_at",
          "duration_sec",
          "output_rows",
          "null_rate",
          "status",
          "message"
        ],
        "title": "AuditItem",
        "description": "Latest pipeline execution audit summary for a single table."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelMetricItem": {
        "properties": {
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "eval_split": {
            "type": "string",
            "title": "Eval Split"
          },
          "sample_count": {
            "type": "integer",
            "title": "Sample Count"
          },
          "mae": {
            "type": "number",
            "title": "Mae"
          },
          "rmse": {
            "type": "number",
            "title": "Rmse"
          },
          "wape_pct": {
            "type": "number",
            "title": "Wape Pct"
          },
          "r2_score": {
            "type": "number",
            "title": "R2 Score"
          },
          "is_best_test_wape": {
            "type": "boolean",
            "title": "Is Best Test Wape"
          },
          "deployed_for_inference": {
            "type": "boolean",
            "title": "Deployed For Inference"
          }
        },
        "type": "object",
        "required": [
          "model_name",
          "eval_split",
          "sample_count",
          "mae",
          "rmse",
          "wape_pct",
          "r2_score",
          "is_best_test_wape",
          "deployed_for_inference"
        ],
        "title": "ModelMetricItem",
        "description": "Model evaluation metrics on the held-out TEST split."
      },
      "OpsHealthSummaryResponse": {
        "properties": {
          "overall_status": {
            "type": "string",
            "title": "Overall Status",
            "description": "Overall health: SUCCESS, WARN, or FAILED."
          },
          "failed_tables": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Failed Tables",
            "description": "Tables whose latest run ended in FAILED."
          },
          "warn_tables": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warn Tables",
            "description": "Tables whose latest run emitted WARN."
          },
          "latest_audits": {
            "items": {
              "$ref": "#/components/schemas/AuditItem"
            },
            "type": "array",
            "title": "Latest Audits"
          },
          "test_model_metrics": {
            "items": {
              "$ref": "#/components/schemas/ModelMetricItem"
            },
            "type": "array",
            "title": "Test Model Metrics"
          }
        },
        "type": "object",
        "required": [
          "overall_status",
          "failed_tables",
          "warn_tables",
          "latest_audits",
          "test_model_metrics"
        ],
        "title": "OpsHealthSummaryResponse",
        "description": "Aggregated pipeline SLA audit and model performance summary."
      },
      "ReplenishmentAlertItem": {
        "properties": {
          "store_id": {
            "type": "string",
