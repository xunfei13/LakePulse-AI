          "safety_stock_qty",
          "current_available_stock",
          "recommended_order_qty",
          "estimated_order_amount",
          "coverage_days",
          "stockout_risk_level",
          "key_driver_tags",
          "model_version"
        ],
        "title": "ReplenishmentAlertItem",
        "description": "Single store-SKU replenishment recommendation record."
      },
      "ReplenishmentAlertsResponse": {
        "properties": {
          "total_matched": {
            "type": "integer",
            "title": "Total Matched",
            "description": "Total matching SKUs before budget/limit slice."
          },
          "returned_count": {
            "type": "integer",
            "title": "Returned Count",
            "description": "Number of SKUs returned after filtering."
          },
          "total_recommended_order_qty": {
            "type": "integer",
            "title": "Total Recommended Order Qty",
            "description": "Sum of recommended order units."
          },
          "total_estimated_order_amount": {
            "type": "number",
            "title": "Total Estimated Order Amount",
            "description": "Total estimated procurement cost ($)."
          },
          "max_budget": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Budget",
            "description": "Optional procurement budget cap applied."
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReplenishmentAlertItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "total_matched",
          "returned_count",
          "total_recommended_order_qty",
          "total_estimated_order_amount",
          "items"
        ],
        "title": "ReplenishmentAlertsResponse",
        "description": "Filtered and optionally budget-constrained replenishment priority list."
      },
      "SQLQueryRequest": {
        "properties": {
          "sql": {
            "type": "string",
            "title": "Sql",
            "description": "Single DuckDB SELECT or WITH...SELECT query targeting only ads_*, dws_*, or ops_* tables."
          },
          "max_rows": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Max Rows",
            "description": "Requested max rows (server clamps to SQL_MAX_ROWS=500).",
            "default": 100
          }
        },
        "type": "object",
        "required": [
          "sql"
        ],
        "title": "SQLQueryRequest",
        "description": "Dynamic read-only SQL query payload guarded by sqlglot AST firewall."
      },
      "SQLQueryResponse": {
        "properties": {
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Columns"
          },
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rows"
          },
          "referenced_tables": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Referenced Tables"
          },
          "executed_sql": {
            "type": "string",
            "title": "Executed Sql"
          }
        },
        "type": "object",
        "required": [
          "columns",
          "row_count",
          "rows",
          "referenced_tables",
          "executed_sql"
        ],
        "title": "SQLQueryResponse",
        "description": "Result set returned by the read-only SQL gateway."
      },
      "ServiceHealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Service status ('ok')."
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "Configured runtime mode ('local' or 'cluster')."
          },
          "duckdb_ready": {
            "type": "boolean",
            "title": "Duckdb Ready",
            "description": "Whether DuckDB lakehouse file exists."
          },
          "whitelisted_tables": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Whitelisted Tables",
            "description": "Accessible ads_*, dws_*, and ops_* tables."
          }
        },
        "type": "object",
        "required": [
          "status",
          "mode",
          "duckdb_ready",
          "whitelisted_tables"
        ],
        "title": "ServiceHealthResponse",
        "description": "Service liveness and available whitelisted lakehouse tables."
      },
