            "title": "Safety Stock Qty"
          },
          "current_available_stock": {
            "type": "integer",
            "title": "Current Available Stock"
          },
          "recommended_order_qty": {
            "type": "integer",
            "title": "Recommended Order Qty"
          },
          "estimated_order_amount": {
            "type": "number",
            "title": "Estimated Order Amount"
          },
          "coverage_days": {
